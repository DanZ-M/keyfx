/*
 * Korz: hand-wired Corne clone (6 columns x 3 rows + 3 thumbs per half)
 * on a nice!nano v2 (clone).
 */

#include <dt-bindings/zmk/matrix_transform.h>

/ {
	chosen {
		zmk,kscan = &kscan0;
		zmk,matrix-transform = &default_transform;
		zmk,matrix_transform = &default_transform; /* older spelling, harmless */
		zephyr,display = &oled;
	};

	behaviors {
		/* light effects control + left/right sync, see modules/keyfx/include/dt-bindings/zmk/keyfx.h */
		kfx: keyfx {
			compatible = "zmk,behavior-keyfx";
			#binding-cells = <2>;
		};
	};

	default_transform: keymap_transform_0 {
		compatible = "zmk,matrix-transform";
		columns = <12>;
		rows = <4>;

		/*
		 * | SW1  | SW2  | SW3  | SW4  | SW5  | SW6  |   | SW6  | SW5  | SW4  | SW3  | SW2  | SW1  |
		 * | SW7  | SW8  | SW9  | SW10 | SW11 | SW12 |   | SW12 | SW11 | SW10 | SW9  | SW8  | SW7  |
		 * | SW13 | SW14 | SW15 | SW16 | SW17 | SW18 |   | SW18 | SW17 | SW16 | SW15 | SW14 | SW13 |
		 *                      | SW19 | SW20 | SW21 |   | SW21 | SW20 | SW19 |
		 */
		map = <
RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)  RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10) RC(0,11)
RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)  RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10) RC(1,11)
RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)  RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11)
                        RC(3,3) RC(3,4) RC(3,5)  RC(3,6) RC(3,7) RC(3,8)
		>;
	};

	kscan0: kscan {
		compatible = "zmk,kscan-gpio-matrix";
		diode-direction = "col2row";
		wakeup-source;

		row-gpios
			= <&gpio0 22 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> /* P0.22 (D4)  */
			, <&gpio0 24 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> /* P0.24 (D5)  */
			, <&gpio1 0  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> /* P1.00 (D6)  */
			, <&gpio0 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)> /* P0.11 (D7)  */
			;
	};
};

/* SDA = P0.17, SCL = P0.20 (pinctrl comes from the nice_nano board) */
&i2c0 {
	status = "okay";

	oled: ssd1306@3c {
		compatible = "solomon,ssd1306fb";
		reg = <0x3c>;
		width = <128>;
		height = <32>;
		segment-offset = <0>;
		page-offset = <0>;
		display-offset = <0>;
		multiplex-ratio = <31>;
		segment-remap;
		com-invdir;
		com-sequential;
		prechargep = <0xD1>;
		inversion-on;
	};
};
